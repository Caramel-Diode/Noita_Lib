{
    "compilerOptions": {
        "lib": ["DOM", "ESNext", "WebWorker"],
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "module": "esnext",
        "moduleResolution": "node",
        "target": "esnext",
        "checkJs": false,
        "baseUrl": ".",
        "typeRoots": ["./node_modules/@types"],
        "paths": {
            "noita-lib": ["node_modules/@types/noita-lib"],
            "noita-lib/*": ["node_modules/@types/noita-lib/*"]
        }
    },
    "include": ["src/**/*.js", "src/**/*.css", "index.d.ts"]
}